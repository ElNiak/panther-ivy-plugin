{
  "ivy": {
    "command": "bash",
    "args": ["-c", "uvx --from 'git+https://github.com/ElNiak/ivy-lsp' --with z3-solver ivy_lsp 2>>/tmp/ivy-lsp.log"],
    "extensionToLanguage": {
      ".ivy": "ivy"
    },
    "env": {
      "IVY_LSP_INCLUDE_PATHS": "protocol-testing",
      "IVY_LSP_EXCLUDE_PATHS": "submodules,test,doc,examples,notebooks,patches",
      "IVY_LSP_LOG_LEVEL": "INFO",
      "IVY_LSP_WORKSPACE_HINT": "panther/plugins/services/testers/panther_ivy"
    }
  }
}
