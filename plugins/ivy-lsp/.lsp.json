{
  "ivy": {
    "command": "bash",
    "args": ["${CLAUDE_PLUGIN_ROOT}/lsp-start.sh"],
    "extensionToLanguage": {
      ".ivy": "ivy"
    },
    "env": {
      "IVY_LSP_LOG_LEVEL": "INFO",
      "IVY_LSP_ACTIVITY_LEVEL": "file",
      "IVY_LSP_WORKSPACE_HINT": "panther/plugins/services/testers/panther_ivy",
      "IVY_LSP_FAST_INDEX_WORKERS": "8",
      "IVY_LSP_PARSE_WORKERS": "4",
      "IVY_LSP_BULK_WORKERS": "6",
      "IVY_LSP_COMPILE_WORKERS": "2"
    }
  }
}
