{
  "mcpServers": {
    "ivy-tools": {
      "command": "bash",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/start-ivy-tools.sh"
      ],
      "env": {
        "IVY_LSP_LOG_LEVEL": "DEBUG",
        "IVY_LSP_MAX_CONCURRENT_TOOLS": "6",
        "IVY_LSP_FAST_INDEX_WORKERS": "8"
      }
    }
  }
}
