{
  "mcpServers": {
    "ivy-tools": {
      "command": "bash",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/start-ivy-server.sh",
        "--mode",
        "mcp"
      ],
      "env": {
        "CLAUDE_SESSION_ID": "",
        "IVY_LSP_LOG_LEVEL": "${user_config.log_level}",
        "IVY_LSP_DEBUG_LOG": "1",
        "IVY_LSP_MAX_CONCURRENT_TOOLS": "4",
        "IVY_LSP_FAST_INDEX_WORKERS": "4",
        "IVY_LSP_PARSE_WORKERS": "4",
        "IVY_LSP_BULK_WORKERS": "4",
        "IVY_LSP_COMPILE_WORKERS": "2",
        "IVY_LSP_PREWARM_MODEL": "1",
        "IVY_LSP_PREWARM_GRAPH": "1"
      }
    },
    "serena": {
      "command": "bash",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/start-serena.sh"
      ],
      "env": {
        "CLAUDE_SESSION_ID": "",
        "IVY_LSP_LOG_LEVEL": "${user_config.log_level}",
        "PANTHER_IVY_ENABLE_SERENA": "${user_config.enable_serena}"
      }
    }
  }
}
